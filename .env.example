# OpenAI / Compatible LLM API Key
# Compatible with OpenAI (https://platform.openai.com/), Groq, DeepSeek, Ollama
# Leave empty to run 100% free out-of-the-box in Demo Mode!
OPENAI_API_KEY=

# Model Configuration
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_STT=whisper-1
# Optional custom base URL for Groq, DeepSeek, or local Ollama:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# CRM Webhook URL (Defaults to local mock endpoint)
CRM_WEBHOOK_URL=http://localhost:8000/crm/webhook

# Port Configuration
PORT=8000
